{
  "name": "@chaos-music/desktop",
  "version": "0.2.0",
  "private": true,
  "description": "Chaos Music desktop host",
  "main": "dist/main/index.js",
  "scripts": {
    "rebuild:native": "electron-builder install-app-deps",
    "dev": "npm run rebuild:native && electron-vite dev --config electron.vite.config.ts",
    "build": "tsc --noEmit -p tsconfig.json && electron-vite build --config electron.vite.config.ts",
    "build:all": "npm run build && npm run rebuild:native && electron-builder",
    "preview": "electron-vite preview --config electron.vite.config.ts",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "format": "prettier --write \"{electron,renderer,shared}/**/*.{ts,tsx,json}\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest --config ../../jest.config.js",
    "test:watch": "jest --config ../../jest.config.js --watch",
    "test:coverage": "jest --config ../../jest.config.js --coverage"
  },
  "dependencies": {
    "@chaos-music/adapters-desktop": "0.1.0",
    "@chaos-music/contracts": "0.1.0",
    "@chaos-music/core": "0.1.0",
    "@chaos-music/design-system": "0.1.0",
    "@chaos-music/ui": "0.1.0",
    "@emotion/react": "^11.13.5",
    "@emotion/styled": "^11.13.5",
    "@mui/icons-material": "^6.1.9",
    "@mui/material": "^6.1.9",
    "@reduxjs/toolkit": "^2.0.1",
    "@tanstack/react-query": "^5.17.0",
    "better-sqlite3": "^11.10.0",
    "electron": "^28.3.3",
    "fluent-ffmpeg": "^2.1.2",
    "music-metadata": "^7.14.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-redux": "^9.0.4",
    "react-router-dom": "^6.28.0",
    "uuid": "^9.0.0",
    "youtube-dl-exec": "^2.4.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.2.0",
    "@testing-library/react": "^14.1.2",
    "@testing-library/user-event": "^14.5.2",
    "@types/better-sqlite3": "^7.6.12",
    "@types/fluent-ffmpeg": "^2.1.24",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.6",
    "@types/react": "^18.2.46",
    "@types/react-dom": "^18.2.18",
    "@types/uuid": "^9.0.0",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "electron-builder": "^24.9.1",
    "electron-vite": "^2.0.0",
    "eslint": "^8.56.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "husky": "^8.0.3",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "prettier": "^3.1.1",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.3",
    "vite": "^5.0.12"
  },
  "build": {
    "appId": "com.chaosteam.chaosmusic",
    "productName": "Chaos Music",
    "directories": { "output": "release" },
    "files": ["dist"]
  }
}
