{
  "name": "chaos-music",
  "version": "0.2.0",
  "private": true,
  "description": "Chaos Music multi-platform music player workspace",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @chaos-music/desktop",
    "build": "npm run build --workspace @chaos-music/desktop && npm run typecheck --workspaces --if-present",
    "build:all": "npm run build:all --workspace @chaos-music/desktop",
    "preview": "npm run preview --workspace @chaos-music/desktop",
    "lint": "npm run lint --workspace @chaos-music/desktop",
    "format": "npm run format --workspace @chaos-music/desktop",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "jest --config jest.config.js",
    "test:watch": "jest --config jest.config.js --watch",
    "test:coverage": "jest --config jest.config.js --coverage"
  },
  "devDependencies": {
    "@types/jest": "^29.5.11",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  }
}
